#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0-macos"

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Ensure macOS
OS="$(uname -s)"
if [[ "$OS" != "Darwin" ]]; then
  echo -e "${RED}This script is macOS-only. Detected: $OS${NC}"
  exit 1
fi

_print() {
  # On macOS, echo -e works fine
  echo -e "$1"
}

_prompt() {
  local message="$1"
  local variable="$2"
  _print "$message"
  read -r "$variable"
}

# Fetch username from the system
USERNAME="$(whoami)"
export USERNAME

# If the username is 'root', ask the user for their username
if [[ "$USERNAME" == "root" ]]; then
  _prompt "${YELLOW}You're running as $USERNAME. Please enter your desired username: ${NC}" USERNAME
fi

# Fetch git identity if available
GIT_EMAIL=""
GIT_NAME=""

if command -v git >/dev/null 2>&1; then
  GIT_EMAIL="$(git config --get user.email || true)"
  GIT_NAME="$(git config --get user.name || true)"
else
  _print "${YELLOW}Git is not available on this system. You'll be prompted for name/email.${NC}"
fi

# Ask if missing
if [[ -z "${GIT_EMAIL}" ]]; then
  _prompt "${YELLOW}Please enter your email: ${NC}" GIT_EMAIL
fi

if [[ -z "${GIT_NAME}" ]]; then
  _prompt "${YELLOW}Please enter your name: ${NC}" GIT_NAME
fi

export GIT_EMAIL
export GIT_NAME

confirm_details() {
  _print "${GREEN}Username: $USERNAME${NC}"
  _print "${GREEN}Email:    $GIT_EMAIL${NC}"
  _print "${GREEN}Name:     $GIT_NAME${NC}"
  _prompt "${YELLOW}Is this correct? yes/no [yes]: ${NC}" choice
  choice="${choice:-yes}"

  case "$choice" in
    [Nn] | [Nn][Oo] )
      _print "${RED}Exiting script.${NC}"
      exit 1
      ;;
    [Yy] | [Yy][Ee][Ss] )
      _print "${GREEN}Continuing...${NC}"
      ;;
    * )
      _print "${RED}Invalid option. Exiting script.${NC}"
      exit 1
      ;;
  esac
}

confirm_details

replace_tokens() {
  local file="$1"
  if [[ "$(basename "$file")" != "apply" ]]; then
    # macOS sed requires -i ''
    LC_ALL=C LANG=C sed -i '' -e "s/%USER%/${USERNAME}/g" "$file"
    LC_ALL=C LANG=C sed -i '' -e "s/%EMAIL%/${GIT_EMAIL}/g" "$file"
    LC_ALL=C LANG=C sed -i '' -e "s/%NAME%/${GIT_NAME}/g" "$file"
  fi
}

export -f replace_tokens

# Replace in all regular files (as in original), you can narrow to *.nix if you want
find . -type f -exec bash -c 'replace_tokens "$0"' {} \;

echo "$USERNAME" > /tmp/username.txt
_print "${GREEN}User $USERNAME information applied (macOS).${NC}"

